{
  "name": "daedalus",
  "productName": "Daedalus",
  "version": "11.6.0",
  "description": "Cryptocurrency Wallet",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "concurrently --kill-others --success first --names renderer,main 'yarn dev:renderer' 'wait-on http://localhost:8080 && yarn dev:main'",
    "dev:windows": "cross-env DAEDALUS_INSTALL_DIRECTORY=\"C:\\Program Files\\Daedalus Testnet\" DAEDALUS_CONFIG_FILE=\"C:\\Program Files\\Daedalus Testnet\\daedalus-config.json\" yarn dev",
    "dev:main": "cross-env NODE_ENV=development yarn build:main --watch",
    "dev:renderer": "concurrently 'yarn typedef:sass --watch' 'cross-env NODE_ENV=development yarn webpack serve -c source/renderer/webpack.config.js --progress'",
    "build": "yarn build:cleanup && yarn build:main && yarn build:renderer",
    "build:main": "yarn webpack -c source/main/webpack.config.js --progress",
    "build:renderer": "yarn webpack -c source/renderer/webpack.config.js --progress",
    "build:cleanup": "rimraf ./dist",
    "build:electron": "./scripts/rebuild-native-modules.sh",
    "check:all": "yarn fmt:check && yarn lint && yarn compile && yarn stylelint && yarn i18n:manage && yarn storybook:build",
    "start": "node scripts/start-watchdog.cjs",
    "start:dev": "nodemon --watch 'dist/main' --exec 'NODE_ENV=development yarn start'",
    "test": "NODE_ENV=test yarn build && yarn test:unit && yarn test:e2e:fail-fast",
    "test:jest": "jest",
    "test:trusted-window": "electron --disable-gpu tests/security/trusted-window/main.js",
    "test:trusted-ipc": "electron --disable-gpu tests/security/trusted-ipc/main.js",
    "test:sandbox-canary": "electron --disable-gpu tests/security/sandbox-canary/main.js",
    "test:dapp-session": "electron --disable-gpu tests/security/dapp-session/main.js",
    "test:dapp-egress": "electron --disable-gpu tests/security/dapp-guest/main.js",
    "test:dapp-security": "node tests/security/dapp-guest/run-installed-package.cjs",
    "test:generate:report": "yarn node-swc tests/reporter.ts",
    "test:unit": "yarn cucumber:run --require 'tests/**/unit/**/steps/**/*.ts' --tags '@unit and not @skip and not @wip'",
    "test:unit:rerun": "yarn cucumber:rerun --require 'tests/**/unit/**/steps/**/*.ts' --tags '@unit and not @skip and not @wip'",
    "test:unit:watch": "nodemon --watch source --watch tests --exec \"yarn test:unit --tags '@unit and @watch'\"",
    "test:unit:unbound": "yarn cucumber:run --require 'tests/**/unit/**/steps/**/*.ts' --tags '@unbound and not @skip and not @wip'",
    "test:e2e": "yarn cucumber:run --require 'tests/setup-e2e.ts' --require 'tests/**/e2e/**/*.ts' --tags '@e2e and not @skip and not @wip'",
    "test:e2e:fail-fast": "yarn cucumber:fail-fast --require 'tests/setup-e2e.ts' --require 'tests/**/e2e/**/*.ts' --tags '@e2e and not @skip and not @wip'",
    "test:e2e:rerun": "yarn cucumber:rerun --require 'tests/setup-e2e.ts' --require 'tests/**/e2e/**/*.ts' --tags '@e2e and not @skip and not @wip'",
    "test:e2e:rerun:fail-fast": "yarn cucumber:rerun --require 'tests/setup-e2e.ts' --require 'tests/**/e2e/**/*.ts' --tags '@e2e and not @skip and not @wip'",
    "test:e2e:watch": "gulp test:e2e:watch",
    "test:e2e:watch:once": "KEEP_APP_AFTER_TESTS=true yarn test:e2e --tags '@e2e and @watch'",
    "test:hardware-wallets": "cross-env ELECTRON_RUN_AS_NODE=1 electron -r @swc-node/register hardware-wallet-tests/index.ts",
    "hardware:ledger:task607": "cross-env ELECTRON_RUN_AS_NODE=1 electron -r @swc-node/register hardware-wallet-tests/task607-ledger.ts",
    "hardware:ledger:flex-interactive": "cross-env ELECTRON_RUN_AS_NODE=1 electron -r @swc-node/register hardware-wallet-tests/ledger-flex-interactive.ts",
    "cucumber": "cross-env NODE_ENV=test cucumber-js --require-module '@swc-node/register' --require 'tests/setup-common.ts' -f json:tests-report/report-data.json -f summary:tests-report/summary.log -f node_modules/cucumber-pretty:tests-report/results.log --format-options '{\"snippetInterface\": \"async-await\"}' -f node_modules/cucumber-pretty --format-options '{\"snippetInterface\": \"async-await\"}' -f rerun:tests/@rerun.txt",
    "cucumber:run": "yarn cucumber tests",
    "cucumber:fail-fast": "yarn cucumber tests --fail-fast",
    "cucumber:rerun": "yarn cucumber tests-report/@rerun.txt",
    "cucumber:rerun:fail-fast": "yarn cucumber tests-report/@rerun.txt --fail-fast",
    "node-swc": "node -r @swc-node/register",
    "debug": "gulp debug",
    "package": "cross-env NODE_ENV=production yarn build && cross-env NODE_ENV=production yarn node-swc scripts/package.js",
    "package:all": "yarn package --all",
    "lint": "eslint --format=node_modules/eslint-formatter-pretty source storybook utils --ext .ts,.tsx",
    "lint:fix": "eslint --fix --fix-type problem --ext '.ts,.tsx' source storybook utils",
    "compile": "tsc --noEmit",
    "precompile": "yarn typedef:sass",
    "prettier": "./node_modules/.bin/prettier \"**/*.*\"",
    "fmt:check": "nix fmt -- --ci",
    "prettier:check": "yarn prettier --check",
    "prettier:format": "yarn prettier --write --log-level warn",
    "stylelint": "./node_modules/.bin/stylelint \"**/*.scss\"",
    "stylelint:fix": "yarn stylelint --fix",
    "i18n:extract": "formatjs extract 'source/**/*.{ts,tsx}' --ignore='**/*.d.ts' --format='translations/formatter.js' --extract-source-location --out-file='translations/messages.json'",
    "i18n:check": "yarn node-swc ./translations/translation-runner.ts",
    "i18n:manage": "yarn i18n:extract && yarn i18n:check",
    "storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 -c storybook --ci",
    "storybook:build": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook build -c storybook -o dist/storybook",
    "themes:check:createTheme": "gulp build:themes && yarn node-swc ./dist/scripts/check.js",
    "themes:update": "gulp build:themes && yarn node-swc ./dist/scripts/update.js && yarn prettier --log-level warn --write source/renderer/app/themes/daedalus/*.ts",
    "themes:copy": "yarn node-swc source/renderer/app/themes/utils/copyTheme.ts && yarn prettier --log-level warn --write source/renderer/app/themes/daedalus/*.ts",
    "clear:cache": "rimraf ./node_modules/.cache",
    "clear:translations": "rimraf ./translations/messages",
    "nix:mainnet": "cross-env GC_DONT_GC=1 nix develop -L .#mainnet",
    "nix:preview": "cross-env GC_DONT_GC=1 nix develop -L .#preview",
    "nix:preprod": "cross-env GC_DONT_GC=1 nix develop -L .#preprod",
    "byron:wallet:importer": "yarn node-swc utils/api-importer/byron-wallet-importer.ts",
    "shelley:wallet:importer": "yarn node-swc utils/api-importer/shelley-wallet-importer.ts",
    "mary:wallet:importer": "yarn node-swc utils/api-importer/mary-wallet-importer.ts",
    "itn:byron:wallet:importer": "yarn node-swc utils/api-importer/itn-byron-wallet-importer.ts",
    "itn:shelley:wallet:importer": "yarn node-swc utils/api-importer/itn-shelley-wallet-importer.ts",
    "yoroi:wallet:importer": "yarn node-swc utils/api-importer/yoroi-wallet-importer.ts",
    "create-news-verification-hashes": "yarn node-swc utils/create-news-verification-hashes/index.ts",
    "typedef:sass": "typed-scss-modules source/renderer/app",
    "postinstall": "patch-package --error-on-fail"
  },
  "bin": {
    "electron": "./node_modules/.bin/electron"
  },
