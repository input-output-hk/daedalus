      "forms": ["one-complete-embedded-item"],
      "reject": [
        "wrong-location",
        "embedded-trailing-data",
        "malformed-embedded-item"
      ]
    },
    {
      "family": "other-tags",
      "decision": "accept-only-at-cddl-declared-locations",
      "forms": ["2", "3", "30", "102", "121-127", "1280-1400", "259"],
