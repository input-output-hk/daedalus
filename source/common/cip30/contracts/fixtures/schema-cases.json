  "javascriptOnlyCases": [
    { "name": "optional-explicit-undefined", "expected": "same-as-omitted" },
    {
      "name": "required-explicit-undefined",
      "expected": "APIError.InvalidRequest"
    },
    {
      "name": "extra-trailing-undefined",
      "expected": "APIError.InvalidRequest"
    },
    { "name": "nan", "expected": "APIError.InvalidRequest" },
    { "name": "positive-infinity", "expected": "APIError.InvalidRequest" },
    { "name": "function", "expected": "APIError.InvalidRequest" },
    { "name": "symbol", "expected": "APIError.InvalidRequest" },
    { "name": "bigint-number-argument", "expected": "APIError.InvalidRequest" },
    {
      "name": "inherited-enumerable-field",
      "expected": "APIError.InvalidRequest"
    },
    { "name": "accessor-field", "expected": "APIError.InvalidRequest" }
  ],
  "expectedRejections": {
