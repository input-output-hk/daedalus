exports[`CurrentDRepSummary core states renders abstain with a caption and no DRep id (snapshot) 1`] = `
<section
  aria-label="Currently Delegated To"
  class="component"
>
  <h3
    class="header"
  >
    Currently Delegated To
  </h3>
  <div
    class="statusRow"
  >
    <span
      class="statusBadge"
    >
      <span
        aria-hidden="true"
        class="glyph"
      >
        ⊘
      </span>
      Abstain
    </span>
  </div>
  <p
    class="caption"
  >
    Your stake is recorded on chain as not participating in governance.
  </p>
</section>
`;

