// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`CurrentDRepSummary DRep status badge leaves the inactive badge to say it, with no caption beneath 1`] = `
<section
  aria-label="Currently Delegated To"
  class="component"
>
  <h3
    class="header"
  >
    Currently Delegated To
  </h3>
  <div
    class="statusRow"
  >
    <span
      aria-label="Inactive"
      class="badge inactive"
    >
      <span
        class="label"
      >
        Inactive
      </span>
    </span>
  </div>
  <div
    class="idRow"
  >
    <span
      class="container"
    >
      <span
        class="root isShowingOnHover"
      >
        <div
          class="bubble alignLeft nowrap root openUpward transparent"
        >
          <div
            class="bubble"
            data-bubble-container="true"
          >
            drep1y2sm9s75uhmqwxpf8f94cmt737g2rvkr6njlvpcc9yaykhq23nmjy
          </div>
          <span
            data-bubble-arrow="true"
          />
        </div>
        <code
          aria-label="drep1y2sm9s75uhmqwxpf8f94cmt737g2rvkr6njlvpcc9yaykhq23nmjy"
          class="id"
        >
          drep1y2s…23nmjy
        </code>
      </span>
      <button
        aria-label="Copy DRep ID"
        class="iconButton"
        title="Copy DRep ID"
        type="button"
      >
        <svg />
      </button>
    </span>
  </div>
</section>
`;

