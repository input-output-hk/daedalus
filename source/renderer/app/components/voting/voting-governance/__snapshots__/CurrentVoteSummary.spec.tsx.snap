    </span>
  </div>
</section>
`;

exports[`CurrentVoteSummary core states renders the noDelegation warning, subline, and CTA (snapshot) 1`] = `
<section
  aria-label="!!!No governance delegation"
  class="component"
>
  <h3
    class="header"
  >
    !!!No governance delegation
  </h3>
  <p
    class="warning"
    role="alert"
  >
    <span
      aria-hidden="true"
      class="warningGlyph"
    >
      !
    </span>
    !!!Your staking rewards cannot be withdrawn until you delegate this wallet's voting power to a DRep, Abstain, or No Confidence.
  </p>
  <p
    class="subline"
  >
    !!!Daedalus will not pick a DRep for you — choose how you want your voting power to participate in Cardano governance.
  </p>
  <div>
    <button
      class="cta root root"
      label="!!!Choose a delegation"
    >
      !!!Choose a delegation
    </button>
  </div>
</section>
`;
