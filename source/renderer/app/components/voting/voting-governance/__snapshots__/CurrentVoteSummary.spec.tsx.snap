exports[`CurrentVoteSummary core states renders the DRep id row with the on-chain label and no badge (snapshot) 1`] = `
<section
  aria-label="!!!Current delegation"
  class="component"
>
  <h3
    class="header"
  >
    !!!Current delegation
  </h3>
  <div
    class="statusRow"
  >
    <span
      class="statusBadge"
    >
      <span
        aria-hidden="true"
        class="glyph"
      >
        ●
      </span>
      !!!Delegated to DRep
    </span>
    <span
      class="sourceLabel"
    >
      !!!On-chain
    </span>
  </div>
  <div
    class="idRow"
  >
    <span
      class="container"
    >
      <span
        class="root isShowingOnHover"
      >
        <div
          class="bubble alignLeft nowrap root openUpward transparent"
        >
          <div
