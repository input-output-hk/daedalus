exports[`CurrentVoteSummary core states renders abstain with a caption and no DRep id (snapshot) 1`] = `
<section
  aria-label="!!!Current delegation"
  class="component"
>
  <h3
    class="header"
  >
    !!!Current delegation
  </h3>
  <div
    class="statusRow"
  >
    <span
      class="statusBadge"
    >
      <span
        aria-hidden="true"
        class="glyph"
      >
        ⊘
      </span>
      !!!Abstain
    </span>
  </div>
  <p
    class="caption"
  >
    !!!Your stake is recorded on chain as not participating in governance. Rewards can be withdrawn.
  </p>
</section>
`;

